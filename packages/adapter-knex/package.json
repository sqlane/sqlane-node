{
    "name": "@sqlane/adapter-knex",
    "version": "0.2.0",
    "description": "knex adapter of sqlane: enqueue jobs in knex transactions",
    "keywords": [
        "background-jobs",
        "job",
        "knex",
        "mysql",
        "postgresql",
        "queue",
        "transactional"
    ],
    "homepage": "https://github.com/sqlane/sqlane-node/tree/main/packages/adapter-knex#readme",
    "bugs": "https://github.com/sqlane/sqlane-node/issues",
    "license": "MIT",
    "author": "Klim Pal",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sqlane/sqlane-node.git",
        "directory": "packages/adapter-knex"
    },
    "files": [
        "src",
        "!src/**/*.test.js",
        "types"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build:types": "node --eval \"require('node:fs').rmSync('types', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "check:types": "out=$(mktemp -d) && tsc -p tsconfig.build.json --declarationDir \"$out\" && diff -r types \"$out\"; status=$?; rm -rf \"$out\"; exit $status",
        "lint:package": "publint --strict",
        "lint:types": "attw --pack . --profile esm-only",
        "prepublishOnly": "publint --strict && attw --pack . --profile esm-only"
    },
    "devDependencies": {
        "@sqlane/core": "workspace:*",
        "@sqlane/testing": "workspace:*",
        "knex": "3.3.0",
        "mysql2": "3.24.6",
        "pg": "8.23.1"
    },
    "peerDependencies": {
        "@sqlane/core": "workspace:^",
        "knex": "^3.0.0"
    },
    "engines": {
        "node": ">=22.12.0"
    }
}
