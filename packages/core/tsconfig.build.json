{
    // Generates the declarations of the package (types/), from the JSDoc of src/. The files are committed: CI fails if
    // they differ from a fresh build.
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationDir": "types",
        "noEmitOnError": true,
        "rootDir": "src",
        "stripInternal": false
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.js"]
}
