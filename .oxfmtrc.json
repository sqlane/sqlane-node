{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    // Formats the non-JS files only (JSON, YAML, Markdown, TOML...). oxlint formats JS/TS (@stylistic rules).
    "printWidth": 120,
    "tabWidth": 4,
    "singleQuote": true,
    "embeddedLanguageFormatting": "off",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ],
    "ignorePatterns": [
        "pnpm-lock.yaml",
        "coverage/**",
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.ts",
        "**/*.mts",
        "**/*.cts",
        "**/*.jsx",
        "**/*.tsx"
    ]
}
