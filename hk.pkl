amends "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

// Shared by the pre-commit, check and fix hooks
steps {
    // JS/TS: lint and formatting (@stylistic rules); the fix applies them
    ["oxlint"] = Builtins.ox_lint
    // Other files: formatting
    ["oxfmt"] = (Builtins.oxfmt) {
        glob = List("**/*.json", "**/*.jsonc", "**/*.json5", "**/*.yaml", "**/*.yml", "**/*.toml", "**/*.md", "**/*.markdown")
    }
    // JSDoc type check of the whole project (the builtin only matches *.ts)
    ["tsc"] = (Builtins.tsc) {
        glob = List("**/*.js", "**/*.mjs", "**/*.cjs", "**/*.ts", "tsconfig.json")
        // A package of its own, with dependencies that CI does not install: see bench/compare/README.md
        exclude = List("bench/compare/**")
    }
    // The package that npm would publish: exports, files; TypeScript finds the declarations of each export (Are the
    // Types Wrong). One step: both pack the package, in the same place.
    ["publint"] {
        glob = List("package.json", "types/**")
        check = "pnpm lint:package && pnpm lint:types"
        // It packs types/: not while the types step rebuilds it
        depends = List("types")
    }
    // The declarations (types/): generated from the JSDoc of src/ and committed. A commit regenerates and stages them;
    // the check fails if they differ from a fresh build.
    ["types"] {
        glob = List("src/**/*.js", "tsconfig.json", "tsconfig.build.json", "types/**")
        check = "pnpm check:types"
        fix = "pnpm build:types"
        stage = "types/**"
    }
    // GitHub Actions workflows: errors, then security issues
    ["actionlint"] = Builtins.actionlint
    ["zizmor"] = Builtins.zizmor
    ["betterleaks"] = Builtins.betterleaks
    // Spelling: reports only, never rewrites (a fix could change an intended name). Fix by hand, or `typos -w`.
    ["typos"] = (Builtins.typos) {
        check = "typos --force-exclude {{files}}"
        check_diff = null
        fix = null
    }
    // File and folder names: snake_case, with the exceptions in .ls-lint.yml
    ["ls_lint"] = Builtins.ls_lint
    ["check_merge_conflict"] = Builtins.check_merge_conflict
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
}

hooks {
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }
}
