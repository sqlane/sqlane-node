{
    // Type-checks the JSDoc of the JS sources, and the TS config files. Emits nothing.
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src", "test", "examples/*.js", "bench", "scripts", "*.js", "*.ts"],
    // The Prisma clients of the tests: generated, not committed. bench/compare: a package of its own, with its own
    // dependencies (its tsconfig.json, once installed)
    "exclude": ["test/prisma/*/generated", "bench/compare"]
}
