{
    // Type-checks the JSDoc of the JS sources, and the TS config files. Emits nothing.
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "target": "ES2024",
        "lib": ["ES2024"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src", "test", "examples", "bench", "*.js", "*.ts"]
}
