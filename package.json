{
    "name": "sqlane-monorepo",
    "private": true,
    "description": "The sqlane packages: @sqlane/core and its adapters",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "lint": "oxlint --deny-warnings",
        "lint:fix": "oxlint --fix",
        "lint:package": "pnpm --recursive --filter './packages/*' lint:package",
        "lint:types": "pnpm --recursive --filter './packages/*' lint:types",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "typecheck": "tsc -p tsconfig.json",
        "build:types": "pnpm --recursive --filter './packages/*' build:types",
        "check:types": "pnpm --recursive --filter './packages/*' check:types",
        "test": "pnpm prisma:generate && vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "pnpm prisma:generate && vitest run --project 'integration:*'",
        "test:watch": "vitest",
        "test:coverage": "pnpm prisma:generate && vitest run --coverage",
        "check": "hk check --all",
        "bench": "node bench/run.js",
        "changeset": "changeset",
        "changeset:version": "changeset version && oxfmt --no-error-on-unmatched-pattern packages/*/CHANGELOG.md",
        "prisma:generate": "pnpm --filter @sqlane/core prisma:generate"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@changesets/changelog-github": "1.0.1",
        "@changesets/cli": "3.0.3",
        "@sqlane/testing": "workspace:*",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/node": "22.20.5",
        "@types/pg": "8.23.1",
        "@vitest/coverage-v8": "5.1.0",
        "mysql2": "3.24.6",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "pg": "8.23.1",
        "pkg-pr-new": "0.0.93",
        "publint": "0.3.25",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@12.18.0"
}
